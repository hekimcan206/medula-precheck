{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Enabled": false
  },
  "Precheck": {
    "MaxInvoicesPerRequest": 5000
  },
  "Oracle": {
    "SchemaOwner": "PRECHECK_OWNER",
    "AppUser": "PRECHECK_APP"
  },
  "ConnectionStrings": {
    "OracleApp": "",
    "OracleOwner": ""
  }
}
