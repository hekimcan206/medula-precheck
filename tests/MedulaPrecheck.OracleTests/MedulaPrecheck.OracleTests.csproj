<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MedulaPrecheck.Core\MedulaPrecheck.Core.csproj" />
    <ProjectReference Include="..\..\src\MedulaPrecheck.Synthetic\MedulaPrecheck.Synthetic.csproj" />
    <ProjectReference Include="..\..\src\MedulaPrecheck.Oracle\MedulaPrecheck.Oracle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same golden set the .NET engine is tested with. -->
    <Compile Include="..\MedulaPrecheck.UnitTests\Golden\GoldenCases.cs" Link="Golden\GoldenCases.cs" />
    <!-- The exact user-creation script docker compose mounts, so least privilege is tested, not assumed. -->
    <None Include="..\..\deploy\oracle\init\01-users.sh" Link="oracle-init\01-users.sh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
  </ItemGroup>

</Project>
